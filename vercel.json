{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "views/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(config|includes)/(.*)",
      "status": 403
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "^/$",
      "dest": "/index.php"
    },
    {
      "src": "^/([a-zA-Z0-9_-]+)\\.php$",
      "dest": "/$1.php"
    },
    {
      "src": "^/([a-zA-Z0-9_-]+)$",
      "dest": "/$1.php"
    },
    {
      "src": "^/views/(.*)$",
      "dest": "/views/$1"
    }
  ]
}
