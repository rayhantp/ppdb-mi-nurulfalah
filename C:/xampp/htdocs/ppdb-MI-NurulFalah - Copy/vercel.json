{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "views/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(config|includes)/(.*)",
      "status": 403
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    }
  ]
}
